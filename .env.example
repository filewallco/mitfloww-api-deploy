# ==============================================================================
# MitFloww Backend API - Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:pw@127.0.0.1:5432/mitfloww

# Server Port
PORT=4001

# Public Web Application Base URL
APP_URL=http://localhost:3000

# ----------------------------------------------------
# Multi-Core Clustering & Scaling
# ----------------------------------------------------
# Set NODE_CLUSTER=true to fork workers across all available CPU cores. Defaults to false in dev, true in production.
NODE_CLUSTER=false
# Number of cluster worker processes to spawn (defaults to os.availableParallelism(), max 8)
WEB_CONCURRENCY=4

# ----------------------------------------------------
# In-Process Puppeteer PDF Engine
# ----------------------------------------------------
# Maximum concurrent PDF render jobs (default: 2)
PDF_CONCURRENCY_LIMIT=2
# Inactive idle duration in ms before closing Chromium to liberate RAM (default: 60000ms)
PDF_IDLE_TIMEOUT_MS=60000
# Maximum queue timeout in ms before falling back to pdf-lib (default: 30000ms)
PDF_QUEUE_TIMEOUT_MS=30000

# ----------------------------------------------------
# Logging Configuration
# ----------------------------------------------------
# Set LOG_TO_CONSOLE=true to output logs to terminal console. Defaults to false (logs go exclusively to file & DB)
LOG_TO_CONSOLE=false
# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ----------------------------------------------------
# File Storage Configuration
# ----------------------------------------------------
# Storage provider: "local" (local disk storage) or "r2" (Cloudflare R2 object storage)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/storage

# Cloudflare R2 Object Storage Credentials
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mitfloww-files
ASSETS_BUCKET_NAME=mitfloww-assets
R2_PUBLIC_BASE_URL=https://assets.mitfloww.com
LOGIN_VIDEO_FILENAME=Logoreveal_Vertical.mp4

# Optional R2 Tuning Settings
R2_CONNECT_TIMEOUT_MS=10000
R2_REQUEST_TIMEOUT_MS=30000
R2_MAX_ATTEMPTS=3
R2_S3_ENDPOINT=
R2_ENDPOINT_IP_OVERRIDE=
R2_JURISDICTION=

# ----------------------------------------------------
# Background Processing Worker
# ----------------------------------------------------
PROCESSING_CALLBACK_BASE_URL=http://localhost:4001
PROCESSING_CALLBACK_TOKEN=change-me-to-a-secure-random-token
WORKER_API_BASE_URL=http://localhost:4000
WORKER_API_TOKEN=change-me-to-a-secure-random-token

# ----------------------------------------------------
# Production Authentication & Security Configuration
# ----------------------------------------------------
# Secret used for signing 15-minute access token JWTs and rotating sessions
SESSION_SECRET=your-super-secret-session-key-minimum-32-chars
PASSWORD_RESET_SECRET=your-password-reset-signing-key-minimum-32-chars
PROJECT_SHARE_SIGNING_SECRET=your-project-share-secret-minimum-32-chars

# Secret salt used for HMAC-SHA256 hashing single-use 6-digit OTP codes (defaults to SESSION_SECRET if unset)
OTP_SECRET=your-otp-signing-salt-minimum-32-chars

# Google OAuth 2.0 Client ID (matches the client ID configured in web)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ----------------------------------------------------
# Transactional Email Provider (Resend)
# ----------------------------------------------------
# Leave blank to use Dev Mock mode (logs OTPs and emails to console in development)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
# Verified domain sender address or onboarding@resend.dev for initial sandbox testing
EMAIL_FROM=MitFloww <notifications@yourdomain.com>

GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here


# ----------------------------------------------------
# 10. Multi-Gateway Payment System Configuration
# ----------------------------------------------------
# Default and regional provider routing
# Supported: razorpay | cashfree | stripe
PAYMENT_DEFAULT_PROVIDER=razorpay
PAYMENT_DOMESTIC_PROVIDER=razorpay
PAYMENT_INTERNATIONAL_PROVIDER=stripe

# Auto-capture payments immediately after authorization (defaults to true)
PAYMENT_AUTO_CAPTURE=true

# Fee passing mode: true = client pays transaction fee + GST surcharge; false = merchant absorbs fee
PAYMENT_FEE_PASSING_ENABLED=true

# --- Razorpay Configuration ---
# Test sandbox credentials format: rzp_test_... / production credentials: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Surcharge fee rate percentage (default: 2.3%)
RAZORPAY_FEE_PERCENT=2.3
# GST on transaction fee percentage (default: 18.0%)
RAZORPAY_TAX_RATE=18.0
# Fixed fee in paise/minor units if applicable (default: 0)
RAZORPAY_FIXED_FEE=0

# --- Cashfree Configuration ---
# Client ID / App ID from Cashfree Merchant Dashboard
CASHFREE_APP_ID=your_cashfree_app_id
# Secret Key from Cashfree Merchant Dashboard
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Webhook secret from Cashfree Dashboard -> Developers -> Webhooks
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
# Environment: "sandbox" (for testing) or "production" (live payments)
CASHFREE_ENVIRONMENT=sandbox
# Surcharge fee rate percentage (default: 2.0%)
CASHFREE_FEE_PERCENT=2.0
# GST on transaction fee percentage (default: 18.0%)
CASHFREE_TAX_RATE=18.0
# Fixed fee in paise/minor units if applicable (default: 0)
CASHFREE_FIXED_FEE=0

# --- Stripe Configuration (International / Optional) ---
# Stripe publishable and secret keys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Surcharge fee rate percentage (default: 2.9%)
STRIPE_FEE_PERCENT=2.9
# Tax rate percentage on fee (default: 0.0%)
STRIPE_TAX_RATE=0.0
# Fixed fee in cents/minor units (default: 30)
STRIPE_FIXED_FEE=30

# --- Background Scheduler & Outbox Watchdog ---
# Secret used by external scheduler or cron to authenticate POST /api/cron/payment-outbox
CRON_SECRET=your_secure_cron_watchdog_secret
